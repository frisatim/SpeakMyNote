# Mobile app configuration. Only EXPO_PUBLIC_* variables are read by the app,
# and every EXPO_PUBLIC_* value is PUBLIC (embedded in the bundle).
# Never put provider keys (Gemini, OpenAI) here.

# Base URL of the Speak My Notes API.
# - Android emulator:      http://10.0.2.2:3000
# - Physical phone on LAN: http://<your PC LAN IP>:3000   (e.g. http://192.168.1.20:3000)
# - Hosted beta API:       https://api.example.com
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
