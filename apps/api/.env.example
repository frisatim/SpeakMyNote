# Speak My Notes API — private configuration. Copy to .env (git-ignored).
# NEVER commit real keys. Provider keys live only here, never in the app.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# mock  -> no paid API calls, deterministic fixtures. Development default.
# live  -> real providers; every key and model ID below becomes required.
# A production build refuses to start in mock mode unless
# ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=true is set explicitly (never for the beta).
PROVIDER_MODE=mock
# ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# --- Live mode only ---------------------------------------------------------
# Gemini (image extraction, tutoring, post-session evaluation).
# Pick stable model IDs that exist in your Google AI Studio project and support
# image input + structured output: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
VISION_MODEL=
TUTOR_MODEL=
EVALUATOR_MODEL=

# OpenAI (transcription). Verify the model's supported parameters:
# https://developers.openai.com/api/docs/guides/speech-to-text
OPENAI_API_KEY=
STT_MODEL=
